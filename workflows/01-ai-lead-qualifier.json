    {
      "id": "5ce3472f-ac69-041c-533c-4c04697518d7",
      "name": "Score Lead (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        120
      ],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_ME",
          "name": "OpenAI account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"gpt-4.1-mini\", temperature: 0.2, response_format: { type: \"json_object\" }, messages: [ { role: \"system\", content: \"You are a B2B sales assistant. Score the inbound lead from 0-100 for purchase intent and fit.\\nReturn ONLY a JSON object with keys:\\n  score (integer 0-100), category (\\\"hot\\\" | \\\"warm\\\" | \\\"cold\\\" | \\\"spam\\\"),\\n  summary (one sentence for the sales team),\\n  reply_draft (a friendly, specific reply email body to the lead, signed \\\"The Team\\\"; empty string for spam).\\nTreat anything that is advertising, SEO offers, or gibberish as spam.\" }, { role: \"user\", content: \"Name: \" + $('Validate & Normalize').item.json.name + \"\\nCompany: \" + $('Validate & Normalize').item.json.company + \"\\nEmail: \" + $('Validate & Normalize').item.json.email + \"\\nMessage: \" + $('Validate & Normalize').item.json.message } ] }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "7e688aa9-0a2d-6bc0-1fef-32393d979654",
      "name": "Parse AI Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        120
      ],
      "parameters": {
        "jsCode": "// Code node: \"Parse AI Score\"\n// Merges the model's JSON verdict back onto the original lead and decides\n// where the lead goes next. Any malformed model output is routed to a human\n// instead of being auto-answered.\nconst leads = $('Validate & Normalize').all();\nconst CATEGORIES = ['hot', 'warm', 'cold', 'spam'];\n\nreturn $input.all().map((item, i) => {\n  const lead = { ...(leads[i]?.json ?? {}) };\n  delete lead.valid;\n  delete lead.errors;\n\n  let ai = null;\n  try {\n    const content = item.json.choices?.[0]?.message?.content;\n    const parsed = typeof content === 'string' ? JSON.parse(content) : null;\n    if (parsed && typeof parsed === 'object') ai = parsed;\n  } catch (e) {\n    ai = null;\n  }\n\n  if (!ai) {\n    return {\n      json: {\n        ...lead,\n        score: null,\n        category: 'needs_review',\n        summary: 'AI scoring failed - please review manually.',\n        reply_draft: '',\n        route: 'alert',\n      },\n    };\n  }\n\n  const score = Math.max(0, Math.min(100, Math.round(Number(ai.score) || 0)));\n  const category = CATEGORIES.includes(ai.category)\n    ? ai.category\n    : score >= 70 ? 'hot' : score >= 40 ? 'warm' : 'cold';\n  const replyDraft = String(ai.reply_draft ?? '').trim().slice(0, 3000);\n\n  let route = 'reply';\n  if (category === 'spam') route = 'ignore';\n  else if (category === 'hot' || score >= 70) route = 'alert';\n  else if (!replyDraft) route = 'alert';\n\n  return {\n    json: {\n      ...lead,\n      score,\n      category,\n      summary: String(ai.summary ?? '').trim().slice(0, 500),\n      reply_draft: replyDraft,\n      route,\n    },\n  };\n});\n"
      }
    },
