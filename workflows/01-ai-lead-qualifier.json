{
  "id": "9ea2278e837474e7",
  "name": "AI Lead Qualifier (Webhook → OpenAI → Slack / Sheets / Email)",
  "active": false,
  "nodes": [
    {
      "id": "1220c4c0-ced9-9ac6-cf60-855402b99332",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -460,
        -240
      ],
      "parameters": {
        "content": "## AI Lead Qualifier\nReceives website form leads, scores them with an LLM and routes them:\n- **Hot / unclear** → instant Slack alert to sales\n- **Warm / cold** → personalised AI reply email\n- **Spam** → logged only\nEvery lead is logged to Google Sheets.\n\nThe OpenAI call uses plain HTTP so any OpenAI-compatible API (Azure, Groq, local LLM) works.",
        "width": 400,
        "height": 300,
        "color": 4
      }
    },
    {
      "id": "14d20f5b-083c-8448-df30-1b246baf418a",
      "name": "Lead Form Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -400,
        200
      ],
      "webhookId": "631dfc16-2148-37c0-857d-b9c226b6cafa",
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "3f104b1e-6a3d-3d9b-08e3-b14b027c5ac8",
      "name": "Validate & Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -180,
        200
      ],
      "parameters": {
        "jsCode": "// Code node: \"Validate & Normalize\"\n// Cleans up a raw form submission and flags anything we should reject\n// before spending money on an LLM call.\nconst EMAIL_RE = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/;\nconst clean = (v, max) => String(v ?? '').replace(/\\s+/g, ' ').trim().slice(0, max);\n\nreturn $input.all().map((item) => {\n  // Webhook node puts the POST body under `body`; fall back to the item itself.\n  const body = item.json.body ?? item.json;\n  const lead = {\n    name: clean(body.name, 120),\n    email: clean(body.email, 254).toLowerCase(),\n    company: clean(body.company, 160),\n    message: clean(body.message, 4000),\n    source: clean(body.source || 'website', 60),\n    received_at: new Date().toISOString(),\n  };\n\n  const errors = [];\n  if (!lead.name) errors.push('name is required');\n  if (!EMAIL_RE.test(lead.email)) errors.push('a valid email is required');\n  if (lead.message.length < 10) errors.push('message must be at least 10 characters');\n\n  return { json: { ...lead, valid: errors.length === 0, errors } };\n});\n"
      }
    },
    {
